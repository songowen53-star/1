{
  "module": "home-analysis",
  "name": "首页-AI学情分析",
  "version": "20260921A",
  "updated_at": "2026-09-21T00:00:00.000Z",
  "source": "prototype/js/pages-home.js (installHomeAnalysis + 6个API汇总，已提取数据结构)",
  "browser_url": "http://localhost:8788/prototype/index.html",
  "cloud_url": "https://ai-gaokao-static.pages.dev/prototype/index.html",
  "interactions": [
    {
      "id": "enter-home-analysis",
      "type": "navigation",
      "desc": "从首页点击「AI学情分析」卡片进入 home-analysis 页面"
    },
    {
      "id": "switch-period",
      "type": "click",
      "desc": "切换周期分段（近7天/近30天/本学期）"
    },
    {
      "id": "switch-tab-overview",
      "type": "click",
      "desc": "切换「综合概览」Tab：4个统计卡片+学习时长分布+薄弱学科TOP3+优势学科"
    },
    {
      "id": "switch-tab-trend",
      "type": "click",
      "desc": "切换「成绩趋势」Tab：当前预估总分+历史/预测曲线+做题量趋势"
    },
    {
      "id": "switch-tab-radar",
      "type": "click",
      "desc": "切换「能力雷达」Tab：5维能力雷达图（基础/应用/综合/创新/速度）"
    },
    {
      "id": "switch-tab-weak",
      "type": "click",
      "desc": "切换「薄弱分析」Tab：薄弱学科详情+知识点掌握率"
    },
    {
      "id": "switch-tab-loss",
      "type": "click",
      "desc": "切换「失分归因」Tab：Top失分原因+占比"
    },
    {
      "id": "switch-tab-report",
      "type": "click",
      "desc": "切换「AI报告」Tab：AI生成的学情报告（文本）"
    }
  ],
  "interaction_count": 8,
  "data": {
    "periods": [
      { "name": "近7天", "days": 7 },
      { "name": "近30天", "days": 30 },
      { "name": "本学期", "days": 120 }
    ],
    "tabs": [
      { "key": "overview", "name": "综合概览", "icon": "fa-th-large" },
      { "key": "trend", "name": "成绩趋势", "icon": "fa-chart-line" },
      { "key": "radar", "name": "能力雷达", "icon": "fa-crosshairs" },
      { "key": "weak", "name": "薄弱分析", "icon": "fa-exclamation-triangle" },
      { "key": "loss", "name": "失分归因", "icon": "fa-bug" },
      { "key": "report", "name": "AI报告", "icon": "fa-robot" }
    ],
    "tab_count": 6,
    "data_sources": {
      "overview": {
        "apis": ["getLearningDailySeries", "getSubjectMastery", "getAnswerStats"],
        "fields": {
          "cards": [
            { "label": "学习时长", "unit": "h", "color": "#3B82F6" },
            { "label": "做题数量", "unit": "题", "color": "#10B981" },
            { "label": "平均正确率", "unit": "%", "color": "#F59E0B" },
            { "label": "涉及学科", "unit": "科", "color": "#8B5CF6" }
          ],
          "cards_count": 4,
          "has_duration_distribution": true,
          "has_weakest_top3": true,
          "has_strongest": true
        }
      },
      "trend": {
        "apis": ["getPredictScoreTrend", "getAnswerTrend"],
        "fields": {
          "current_estimate_score": true,
          "has_history_line": true,
          "has_predict_line": true,
          "has_answer_count_trend": true
        }
      },
      "radar": {
        "apis": ["getSubjectMastery"],
        "fields": {
          "dimensions": ["基础", "应用", "综合", "创新", "速度"],
          "dimensions_count": 5
        }
      },
      "weak": {
        "apis": ["getSubjectMastery"],
        "fields": {
          "has_weakest_subjects_detail": true,
          "has_knowledge_point_mastery": true
        }
      },
      "loss": {
        "apis": ["getLossAnalysis"],
        "fields": {
          "has_loss_reasons_top": true,
          "has_percentage": true
        }
      },
      "report": {
        "apis": [],
        "fields": {
          "ai_report_text": "AI生成的综合学情报告，含优势/不足/建议三部分"
        }
      }
    },
    "sample_data_overview": {

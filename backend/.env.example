# ========== 阿里云短信（手机验证码登录） ==========
# 在阿里云控制台获取：https://ram.console.aliyun.com/manage/ak
# 子账号需授权：AliyunDysmsFullAccess（仅短信发送）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=

# 短信签名名称（需在阿里云短信控制台审核通过）
# 如：签名内容是"AI高考"，则填写"AI高考"（不带书名号）
ALIYUN_SMS_SIGN_NAME=

# 短信模版 CODE（需在阿里云短信控制台审核通过）
# 模版内容示例：您的验证码是${code}，5分钟内有效，请勿告知他人。
# 审核通过后会得到 SMS_xxxxxxxxx 形式的 CODE
ALIYUN_SMS_TEMPLATE_CODE=

# ========== 使用说明 ==========
# 1. 本地开发：cp backend/.env.example backend/.env 然后填写真实值
#    启动方式：node --env-file=backend/.env backend/server.js
#    或使用 cross-env / dotenv-cli 注入
#
# 2. 未配置以上任意变量时，/api/auth/sms-send 自动降级为演示模式：
#    - 直接返回验证码到响应体的 data.code（方便测试）
#    - 后端控制台打印验证码
#    - 不调用阿里云网关
#
# 3. 生产环境（Cloudflare Pages）：
#    wrangler secret put ALIYUN_SMS_ACCESS_KEY_ID
#    wrangler secret put ALIYUN_SMS_ACCESS_KEY_SECRET
#    wrangler secret put ALIYUN_SMS_SIGN_NAME
#    wrangler secret put ALIYUN_SMS_TEMPLATE_CODE
#    或在 Pages 项目 Settings → Environment variables 中添加
